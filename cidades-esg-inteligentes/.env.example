# Apenas valores de exemplo; copie para .env e defina uma senha local.
POSTGRES_DB=cidades_esg
POSTGRES_USER=esg_user
POSTGRES_PASSWORD=troque-esta-senha
# Porta local; scripts de staging/produção fixam 8081/8082.
APP_PORT=8080
IMAGE_NAME=cidades-esg:local
SPRING_PROFILES_ACTIVE=local
SEED_DATA=true
